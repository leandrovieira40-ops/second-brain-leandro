{
  "name": "second-brain-leandro",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema pessoal de conhecimento baseado em Markdown, Git e IA fundamentada em fontes.",
  "license": "UNLICENSED",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/prepare-e2e-vault.mjs && playwright test",
    "hash-password": "node scripts/hash-password.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {

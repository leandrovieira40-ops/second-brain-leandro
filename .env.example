# Copie para .env.local (nunca versionado) e preencha. Valores reais vão nas variáveis de ambiente
# da Vercel. NENHUMA variável aqui pode ter o prefixo NEXT_PUBLIC_ (iria para o navegador).

# --- Aplicação ---------------------------------------------------------------
APP_NAME="Second Brain Leandro"
APP_TIMEZONE=America/Sao_Paulo

# --- Autenticação (docs/SECURITY.md) -----------------------------------------
# openssl rand -base64 48
AUTH_SECRET=
# npm run hash-password   (formato scrypt:N:r:p:sal:hash, sem "$")
AUTH_PASSWORD_HASH=
# Validade da sessão em horas (padrão 168 = 7 dias)
AUTH_SESSION_TTL_HOURS=168
# Incrementar invalida todas as sessões abertas
AUTH_SESSION_VERSION=1
# Opcional: forçar cookie Secure (padrão: true em produção). Use false só em HTTP local fora de localhost.
AUTH_COOKIE_SECURE=

# --- Vault --------------------------------------------------------------------
# github (produção) ou fs (pasta local: desenvolvimento / uso junto do Obsidian)
VAULT_STORE=github

# Repositório PRIVADO do vault e token fine-grained com acesso SÓ a ele
# (Contents: Read and write; Metadata: Read)
GITHUB_VAULT_OWNER=
GITHUB_VAULT_REPO=
GITHUB_VAULT_BRANCH=main
GITHUB_VAULT_TOKEN=

# Caminho ABSOLUTO do clone local do vault (somente com VAULT_STORE=fs; não funciona na Vercel)
VAULT_FS_ROOT=
